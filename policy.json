{
  "baseBranchPatterns": [
    "main"
  ],
  "packageRules": [
    {
      "description": "FIN-211: recovery of an automatically failed dependency family",
      "matchPackageNames": [
        "github.com/jackc/pgx/v5"
      ],
      "matchDatasources": [
        "go"
      ],
      "recreateWhen": "always",
      "matchJsonata": [
        "newMajor = 5"
      ]
    },
    {
      "description": "FIN-211: recovery of an automatically failed dependency family",
      "matchPackageNames": [
        "google.golang.org/genproto/googleapis/rpc"
      ],
      "matchDatasources": [
        "go"
      ],
      "recreateWhen": "always",
      "matchJsonata": [
        "newMajor = 0"
      ]
    },
    {
      "description": "FIN-211: recovery of an automatically failed dependency family",
      "matchPackageNames": [
        "actions/python-versions"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "recreateWhen": "always",
      "matchJsonata": [
        "newMajor = 3"
      ]
    },
    {
      "description": "FIN-211: recovery of an automatically failed dependency family",
      "matchPackageNames": [
        "renovate"
      ],
      "matchDatasources": [
        "npm"
      ],
      "recreateWhen": "always",
      "matchJsonata": [
        "newMajor = 44"
      ]
    },
    {
      "description": "FIN-211: failed twice; retry explicitly in Dependency Dashboard",
      "matchPackageNames": [
        "github.com/jackc/pgx/v5"
      ],
      "matchDatasources": [
        "go"
      ],
      "dependencyDashboardApproval": true,
      "recreateWhen": "never",
      "groupName": null,
      "additionalBranchPrefix": "fin211-retry-8-",
      "matchNewValue": "/^v5\\.12\\.0$/",
      "matchJsonata": [
        "$not($exists(newDigest)) or newDigest = null"
      ]
    },
    {
      "description": "FIN-211: failed twice; retry explicitly in Dependency Dashboard",
      "matchPackageNames": [
        "google.golang.org/genproto/googleapis/rpc"
      ],
      "matchDatasources": [
        "go"
      ],
      "dependencyDashboardApproval": true,
      "recreateWhen": "never",
      "groupName": null,
      "additionalBranchPrefix": "fin211-retry-8-",
      "matchJsonata": [
        "newDigest = \"d1e00e9f33ab\""
      ]
    },
    {
      "description": "FIN-211: failed twice; retry explicitly in Dependency Dashboard",
      "matchPackageNames": [
        "actions/python-versions"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "dependencyDashboardApproval": true,
      "recreateWhen": "never",
      "groupName": null,
      "additionalBranchPrefix": "fin211-retry-8-",
      "matchNewValue": "/^3\\.15$/",
      "matchJsonata": [
        "$not($exists(newDigest)) or newDigest = null"
      ]
    },
    {
      "description": "FIN-211: failed twice; retry explicitly in Dependency Dashboard",
      "matchPackageNames": [
        "renovate"
      ],
      "matchDatasources": [
        "npm"
      ],
      "dependencyDashboardApproval": true,
      "recreateWhen": "never",
      "groupName": null,
      "additionalBranchPrefix": "fin211-retry-8-",
      "matchJsonata": [
        "newDigest = \"sha512-dSbifWgLlNjMkCJImQgl0yB01W8ROne7BMIiZYJv707DWpPOReJqxQjINcX8Df7KUhzxSu0IUpV5G4sKbwND0A==\""
      ]
    }
  ]
}
